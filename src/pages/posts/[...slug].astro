---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import SiteLayout from "@layouts/SiteLayout.astro";
import {
  Prose,
  TableOfContents,
  PostNav,
  Hero,
  AuthorCard,
} from "@pressmark/astro";
import AuthorAnnotation from "@components/AuthorAnnotation.astro";
import { formatDate, readingTime, tagSlug } from "@lib/utils";
import { AUTHOR } from "@consts";

export async function getStaticPaths() {
  const posts = (await getCollection("posts"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  // Posts are newest-first, so the newer neighbour is the previous index.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
  newer?: CollectionEntry<"posts">;
  older?: CollectionEntry<"posts">;
};

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);

const toItem = (p?: CollectionEntry<"posts">) =>
  p ? { href: `/posts/${p.id}`, title: p.data.title } : undefined;
const prev = toItem(older);
const next = toItem(newer);

const dateLabel = formatDate(post.data.date);
const minutes = readingTime(post.body ?? "");

const coverImage = post.data.cover
  ? await getImage({ src: post.data.cover })
  : undefined;
const coverURL = coverImage
  ? new URL(coverImage.src, Astro.site).href
  : undefined;

/**
 * A table of contents only appears when the post actually has sections to
 * navigate — a three-line TIL gets none, because there is nothing to jump to.
 */
const hasToc = headings.some((h) => h.depth === 2);

---

<SiteLayout
  title={post.data.title}
  description={post.data.description}
  article
  image={coverURL}
  theme={post.data.theme}
  themeSource={`src/content/posts/${post.id}`}
>
  {post.data.cover ? (
    /* Artwork sits behind the header, with the title and tags over it. */
    <Hero
      src={post.data.cover}
      alt={post.data.coverAlt ?? ""}
      variant="banner"
      scrimStyle="gradient"
      position={post.data.coverPosition ?? "center"}
      minHeight="24rem"
    >
      <div class="px-5 pt-10 pb-12 md:px-12">
        <div class="mx-auto max-w-[46rem]">
          <h1 class="font-display font-light text-4xl md:text-5xl leading-[1.04] text-ink tracking-[-0.015em]">
            {post.data.title}
          </h1>

          {post.data.description && (
            <p class="dek mt-6 max-w-[36rem]">
              {post.data.description}
            </p>
          )}
        </div>
      </div>
    </Hero>
  ) : (
    <header class="px-5 pt-10 md:px-12">
      <div class="mx-auto max-w-[46rem]">
        <h1 class="font-display font-light text-4xl md:text-5xl leading-[1.04] text-ink tracking-[-0.015em]">
          {post.data.title}
        </h1>

        {post.data.description && (
          <p class="dek mt-6 max-w-[36rem]">
            {post.data.description}
          </p>
        )}
      </div>
    </header>
  )}

  {/* Everything below the hero. Positioned, so the ToC column can anchor to
      it: the column starts where the hero ends and runs to the end of the
      article, which is exactly the range over which a ToC is useful. */}
  <div class="relative">
    {hasToc && (
      /* Absolute, so it reserves no width and the article stays centred on the
         viewport. The nav inside is sticky: it begins just under the hero,
         then parks at top-20 (clearing the 56px Topbar) for the rest of the
         scroll and stops at the foot of the article.

         Width is capped by `wide-media`, whose figures break out to 54rem:
         the gutter is (vw - 864)/2, less the 24px right margin. 240px clears
         it at 1440 and 288px at 1536, both with 24px to spare — hence the two
         steps rather than one width. */
      <div class="absolute inset-y-0 right-6 w-60 min-[1536px]:w-72 hidden min-[1440px]:block">
        <nav
          class="sticky top-20 max-h-[calc(100vh-7rem)] overflow-y-auto bg-surface/90 backdrop-blur-sm py-2 opacity-60 transition-opacity duration-300 hover:opacity-100 focus-within:opacity-100 motion-reduce:transition-none"
          aria-label="On this page"
        >
          <TableOfContents headings={headings} />
        </nav>
      </div>
    )}

    {/* Byline. Horizontal, directly under the hero, and the only place the
        date and read time appear above the article. */}
    <div class="px-5 md:px-12">
      {/* No rules above or below. They were covering for the band looking
          like content: a portrait and a right-hand column of chips, set at a
          width nothing else on the page used. Fix that and the separation
          comes for free.

          What separates it now is register and space. Nothing here is at body
          size or body leading, and the last thing before the prose is mono —
          the one voice the article never speaks in. 36px above binds the
          byline up to the title; 36px here plus the article's own 40px gives
          76px below, and the accent drop cap lands as the unambiguous start.

          Back on the 46rem measure, so it aligns with the article rather than
          straddling it — which also widens the left margin enough for the note
          to return at xl instead of waiting for the ToC breakpoint. */}
      <div class:list={["byline-row relative mx-auto max-w-[46rem] pb-9",
        /* 36px binds the byline up to the title block — but with a cover
           the title lives inside the hero, so there is no title block to
           bind to and 36px just crowds a full-bleed photo. */
        post.data.cover ? "mt-16" : "mt-9"]}>
        {AUTHOR.NOTE && (
          <AuthorAnnotation text={AUTHOR.NOTE} class="hidden xl:block absolute right-full -top-2 mr-1 w-[11rem]" />
        )}

        {/* The card is the link, so there is no separate "More about me" row
            and no social glyphs asking the reader to leave before they have
            arrived — those live on /about, which is where this goes.

            `href` rather than an anchor wrapped around the component: only the
            name is a real link and it stretches over the card, so the reader
            hears "Tomasz Tomczyk" instead of the whole bio, and `links` could
            be added back without nesting anchors. */}
        <AuthorCard
          name={AUTHOR.NAME}
          avatar={AUTHOR.AVATAR}
          bio={AUTHOR.BIO}
          variant="inline"
          href="/about"
          avatarSize="lg"
        />

        {/* One line, not a column: date, read time and tags are all "about this
            post" and none of them outranks the others. Indented past the
            avatar so it hangs under the name rather than under the photo.
            Outside the anchor above — the tag links cannot nest inside it. */}
        <ul class="byline-facts panel-label mt-3.5 sm:ml-[6.5rem] flex flex-wrap items-center gap-x-2.5 gap-y-2 list-none">
          <li class="flex items-center gap-2">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><rect x="3" y="5" width="18" height="16" rx="1.5"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>
            {dateLabel}
          </li>

          <li aria-hidden="true" class="byline-sep">&middot;</li>

          <li class="flex items-center gap-2">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/></svg>
            {minutes}
          </li>

          {post.data.tags?.map((tag) => (
            <>
              <li aria-hidden="true" class="byline-sep">&middot;</li>
              <li>
                {/* No chip. A pill is a frame, and the point of dropping the
                    rules was to stop framing things that type can just state. */}
                <a
                  href={`/tags/${tagSlug(tag)}`}
                  class="no-underline hover:text-accent transition-colors"
                >#{tag}</a>
              </li>
            </>
          ))}
        </ul>
      </div>
    </div>

    <div class="px-5 py-10 md:px-12">
      <Prose dropcap class="wide-media">
        <Content />
      </Prose>

      <PostNav prev={prev} next={next} class="mx-auto max-w-[46rem] mt-12" />

      <footer class="meta mx-auto mt-12 pt-6 border-t border-line max-w-[46rem] flex items-center justify-between">
        <a href="/posts" class="text-accent hover:underline hover:underline-offset-4">← All posts</a>
        <span>{dateLabel}</span>
      </footer>
    </div>
  </div>
</SiteLayout>
