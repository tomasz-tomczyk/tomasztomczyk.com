---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import SiteLayout from "@layouts/SiteLayout.astro";
import {
  Prose,
  TableOfContents,
  PostNav,
  Hero,
  AuthorCard,
  Badge,
} from "@pressmark/astro";
import { formatDate, readingTime, tagSlug } from "@lib/utils";
import { SOCIAL_ICONS } from "@lib/socialIcons";
import { AUTHOR, SITE, SOCIALS } from "@consts";

export async function getStaticPaths() {
  const posts = (await getCollection("posts"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  // Posts are newest-first, so the newer neighbour is the previous index.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
  newer?: CollectionEntry<"posts">;
  older?: CollectionEntry<"posts">;
};

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);

const toItem = (p?: CollectionEntry<"posts">) =>
  p ? { href: `/posts/${p.id}`, title: p.data.title } : undefined;
const prev = toItem(older);
const next = toItem(newer);

const dateLabel = formatDate(post.data.date);
const minutes = readingTime(post.body ?? "");

const coverImage = post.data.cover
  ? await getImage({ src: post.data.cover })
  : undefined;
const coverURL = coverImage
  ? new URL(coverImage.src, Astro.site).href
  : undefined;

/**
 * A table of contents only appears when the post actually has sections to
 * navigate — a three-line TIL gets none, because there is nothing to jump to.
 */
const hasToc = headings.some((h) => h.depth === 2);

const authorLinks = [
  {
    label: SOCIAL_ICONS.email.label,
    href: `mailto:${SITE.EMAIL}`,
    icon: `<path d="${SOCIAL_ICONS.email.path}" />`,
    iconStyle: "fill" as const,
  },
  ...SOCIALS.map((social) => {
    const glyph = SOCIAL_ICONS[social.NAME];
    return {
      label: glyph?.label ?? social.NAME,
      href: social.HREF,
      icon: glyph ? `<path d="${glyph.path}" />` : undefined,
      iconStyle: "fill" as const,
    };
  }),
];
---

<SiteLayout
  title={post.data.title}
  description={post.data.description}
  article
  image={coverURL}
  theme={post.data.theme}
  themeSource={`src/content/posts/${post.id}`}
>
  {post.data.cover ? (
    /* Artwork sits behind the header, with the title and tags over it. */
    <Hero
      src={post.data.cover}
      alt={post.data.coverAlt ?? ""}
      variant="banner"
      scrimStyle="gradient"
      position={post.data.coverPosition ?? "center"}
      minHeight="24rem"
    >
      <div class="px-5 pt-10 pb-12 md:px-12">
        <div class="mx-auto max-w-[46rem]">
          <h1 class="font-display font-light text-4xl md:text-5xl leading-[1.04] text-ink tracking-[-0.015em]">
            {post.data.title}
          </h1>

          {post.data.description && (
            <p class="dek mt-6 max-w-[36rem]">
              {post.data.description}
            </p>
          )}
        </div>
      </div>
    </Hero>
  ) : (
    <header class="px-5 pt-10 md:px-12">
      <div class="mx-auto max-w-[46rem]">
        <h1 class="font-display font-light text-4xl md:text-5xl leading-[1.04] text-ink tracking-[-0.015em]">
          {post.data.title}
        </h1>

        {post.data.description && (
          <p class="dek mt-6 max-w-[36rem]">
            {post.data.description}
          </p>
        )}
      </div>
    </header>
  )}

  {/* Everything below the hero. Positioned, so the ToC column can anchor to
      it: the column starts where the hero ends and runs to the end of the
      article, which is exactly the range over which a ToC is useful. */}
  <div class="relative">
    {hasToc && (
      /* Absolute, so it reserves no width and the article stays centred on the
         viewport. The nav inside is sticky: it begins just under the hero,
         then parks at top-20 (clearing the 56px Topbar) for the rest of the
         scroll and stops at the foot of the article.

         Width is capped by `wide-media`, whose figures break out to 54rem:
         the gutter is (vw - 864)/2, less the 24px right margin. 240px clears
         it at 1440 and 288px at 1536, both with 24px to spare — hence the two
         steps rather than one width. */
      <div class="absolute inset-y-0 right-6 w-60 min-[1536px]:w-72 hidden min-[1440px]:block">
        <nav
          class="sticky top-20 max-h-[calc(100vh-7rem)] overflow-y-auto bg-surface/90 backdrop-blur-sm py-2"
          aria-label="On this page"
        >
          <TableOfContents headings={headings} />
        </nav>
      </div>
    )}

    {/* Byline. Horizontal, directly under the hero, and the only place the
        date and read time appear above the article. */}
    <div class="px-5 md:px-12">
      <div class="mx-auto max-w-[46rem] mt-10 pt-6 pb-6 border-t border-b border-line flex flex-wrap items-start justify-between gap-6">
        <AuthorCard
          name={AUTHOR.NAME}
          avatar={AUTHOR.AVATAR}
          bio={AUTHOR.BIO}
          links={authorLinks}
          variant="inline"
          eyebrow="Written by"
          class="flex-1 min-w-[20rem]"
        />

        {/* Date, read time and tags together — they are all "about this post"
            rather than part of it, which is why the tags moved off the hero. */}
        <div class="shrink-0 pt-1">
          <ul class="space-y-2">
            <li class="meta flex items-center gap-3">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><rect x="3" y="5" width="18" height="16" rx="1.5"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>
              {dateLabel}
            </li>
            <li class="meta flex items-center gap-3">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="opacity-70"><circle cx="12" cy="12" r="9"/><path d="M12 7v6l4 2"/></svg>
              {minutes}
            </li>
          </ul>

          {post.data.tags && post.data.tags.length > 0 && (
            <ul class="flex flex-wrap gap-2 mt-3 list-none p-0 m-0 max-w-[16rem]">
              {post.data.tags.map((tag) => (
                <li>
                  {/* Badge renders a span, so the link wraps it. The link also
                      carries the type and colour: `badge-meta` inherits both,
                      so the chip matches the date beside it and picks up the
                      hover. */}
                  <a
                    href={`/tags/${tagSlug(tag)}`}
                    class="meta no-underline hover:text-accent transition-colors"
                  >
                    <Badge variant="meta">#{tag}</Badge>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </div>

    <div class="px-5 py-10 md:px-12">
      <Prose dropcap class="wide-media">
        <Content />
      </Prose>

      <PostNav prev={prev} next={next} class="mx-auto max-w-[46rem] mt-12" />

      <footer class="meta mx-auto mt-12 pt-6 border-t border-line max-w-[46rem] flex items-center justify-between">
        <a href="/posts" class="text-accent hover:underline hover:underline-offset-4">← All posts</a>
        <span>{dateLabel}</span>
      </footer>
    </div>
  </div>
</SiteLayout>
