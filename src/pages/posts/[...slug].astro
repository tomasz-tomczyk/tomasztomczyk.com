---
import Icon from "@components/Icon.astro";
import IconLabel from "@components/IconLabel.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import SiteLayout from "@layouts/SiteLayout.astro";
import { Prose, TableOfContents, Hero, AuthorCard } from "@pressmark/astro";
import AuthorAnnotation from "@components/AuthorAnnotation.astro";
import PostFooter from "@components/PostFooter.astro";
import Comments from "@components/Comments.astro";
import ArchiveNote from "@components/ArchiveNote.astro";

import { formatDate, readingTime, tagSlug } from "@lib/utils";
import { AUTHOR } from "@consts";

export async function getStaticPaths() {
  const posts = (await getCollection("posts"))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  // Posts are newest-first, so the newer neighbour is the previous index.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
  newer?: CollectionEntry<"posts">;
  older?: CollectionEntry<"posts">;
};

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);

const toItem = (p?: CollectionEntry<"posts">) =>
  p
    ? {
        href: `/posts/${p.id}`,
        title: p.data.title,
        date: formatDate(p.data.date),
        minutes: readingTime(p.body ?? ""),
      }
    : undefined;
const prev = toItem(older);
const next = toItem(newer);

const dateLabel = formatDate(post.data.date);
const minutes = readingTime(post.body ?? "");

const coverImage = post.data.cover
  ? await getImage({ src: post.data.cover })
  : undefined;
const coverURL = coverImage
  ? new URL(coverImage.src, Astro.site).href
  : undefined;

// No ToC for a post with no sections to jump to.
const hasToc = headings.some((h) => h.depth === 2);
---

<SiteLayout
  title={post.data.title}
  description={post.data.description}
  article
  image={coverURL}
  theme={post.data.theme}
  themeSource={`src/content/posts/${post.id}`}
>
  {
    post.data.cover ? (
      <Hero
        src={post.data.cover}
        alt={post.data.coverAlt ?? ""}
        variant="banner"
        scrimStyle="gradient"
        position={post.data.coverPosition ?? "center"}
        minHeight="24rem"
      >
        <div class="px-5 pt-10 pb-12 md:px-12">
          <div class="mx-auto max-w-measure">
            <h1 class="font-display font-light text-4xl md:text-5xl leading-[1.04] text-ink tracking-[-0.015em]">
              {post.data.title}
            </h1>

            {post.data.description && (
              <p class="dek mt-6 max-w-[36rem]">{post.data.description}</p>
            )}
          </div>
        </div>
      </Hero>
    ) : (
      <header class="px-5 pt-10 md:px-12">
        <div class="mx-auto max-w-measure">
          <h1 class="font-display font-light text-4xl md:text-5xl leading-[1.04] text-ink tracking-[-0.015em]">
            {post.data.title}
          </h1>

          {post.data.description && (
            <p class="dek mt-6 max-w-[36rem]">{post.data.description}</p>
          )}
        </div>
      </header>
    )
  }

  {
    /* Positioned, so the ToC column can span exactly from the end of the hero
      to the foot of the article. */
  }
  <div class="relative">
    {
      hasToc && (
        /* Absolute, so the column reserves no width and the article stays
         centred. top-20 clears the 56px Topbar once the nav sticks.

         Width and breakpoint are both set by `wide-media`, whose figures
         break out to 64rem: the gutter is (vw - 1024)/2, and the column has
         to fit in it less the 24px right margin and a hair of clearance.
         240px clears that at 1600 and 288px at 1728 — hence two steps. */
        <div class="absolute inset-y-0 right-6 w-60 min-[1728px]:w-72 hidden min-[1600px]:block">
          <nav
            class="sticky top-20 max-h-[calc(100vh-7rem)] overflow-y-auto bg-surface/90 backdrop-blur-sm py-2 opacity-60 transition-opacity duration-300 hover:opacity-100 focus-within:opacity-100 motion-reduce:transition-none"
            aria-label="On this page"
          >
            <TableOfContents headings={headings} />
          </nav>
        </div>
      )
    }

    {
      /* Byline. The only place the date and read time appear above the
        article. No rules: what separates it is register and space — nothing
        here sits at body size or body leading. */
    }
    <div class="px-5 md:px-12">
      {
        /* Even air on both sides: pb-4 here plus the article wrapper's own 40px
          gives 56 below, matching the 56 above. Cover posts take a little more
          overhead, since the byline answers to a full-bleed photo rather than
          to a title block. */
      }
      <div
        class:list={[
          "byline-row relative mx-auto max-w-measure pb-4",
          post.data.cover ? "mt-16" : "mt-14",
        ]}
      >
        {
          AUTHOR.NOTE && (
            <AuthorAnnotation
              text={AUTHOR.NOTE}
              class="hidden xl:block absolute right-full -top-2 mr-1 w-[11rem]"
            />
          )
        }

        {
          /* `href` rather than an anchor wrapped around the component: only the
            name is a real link and it stretches over the card, so a screen
            reader announces "Tomasz Tomczyk" instead of the whole bio, and
            `links` could be added back without nesting anchors. */
        }
        <AuthorCard
          name={AUTHOR.NAME}
          avatar={AUTHOR.AVATAR}
          bio={AUTHOR.BIO}
          variant="inline"
          href="/about"
          avatarSize="lg"
        />

        {
          /* Indented past the avatar so it hangs under the name rather than
            under the photo. Kept outside the AuthorCard — the tag links
            cannot nest inside its anchor. */
        }
        <ul
          class="byline-facts panel-label mt-3.5 sm:ml-[6.5rem] flex flex-wrap items-center gap-x-2.5 gap-y-2 list-none"
        >
          <li class="flex items-center gap-2">
            <Icon name="calendar" size={14} class="opacity-70" />
            {dateLabel}
          </li>

          <li aria-hidden="true" class="byline-sep">&middot;</li>

          <li class="flex items-center gap-2">
            <Icon name="clock" size={14} class="opacity-70" />
            {minutes}
          </li>

          {
            post.data.tags?.map((tag) => (
              <>
                <li aria-hidden="true" class="byline-sep">
                  &middot;
                </li>
                <li>
                  <a
                    href={`/tags/${tagSlug(tag)}`}
                    class="no-underline hover:text-accent transition-colors"
                  >
                    <IconLabel label={tag} />
                  </a>
                </li>
              </>
            ))
          }
        </ul>
      </div>
    </div>

    {
      /* No bottom padding: the site footer's own top margin is the only air
        between the foot of a post and the cat. */
    }
    <div class="px-5 pt-10 md:px-12">
      {
        /* MDX has no imports of its own, so every component a post may use has
          to be passed here by name — an unlisted one fails the build with
          "Expected component X to be defined". The dropcap targets the first
          <p>, so a note above it takes nothing. */
      }
      <Prose dropcap class="wide-media">
        <Content components={{ ArchiveNote, IconLabel }} />
      </Prose>

      <Comments discussion={post.data.discussion} />

      <PostFooter prev={prev} next={next} />
    </div>
  </div>
</SiteLayout>
