---
import type { CollectionEntry } from "astro:content";
import SiteLayout from "@layouts/SiteLayout.astro";
import { PanelLabel } from "@pressmark/astro";
import PostListItem from "@components/PostListItem.astro";
import { getTags } from "@lib/tags";

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { name: tag.name, posts: tag.posts },
  }));
}

type Props = { name: string; posts: CollectionEntry<"posts">[] };

const { name, posts } = Astro.props;
const count = `${posts.length} ${posts.length === 1 ? "post" : "posts"}`;
---

<SiteLayout title={`#${name}`} description={`Posts tagged ${name}.`}>
  <div class="px-5 py-10 md:px-12">
    <div class="mx-auto max-w-measure-wide">
      <header class="mb-12">
        <PanelLabel class="mb-7">Tag <span class="opacity-50">/</span> {count}</PanelLabel>
        <h1 class="font-display font-light text-4xl md:text-5xl leading-[1.04] text-ink tracking-[-0.015em]">
          #{name}
        </h1>
      </header>

      <ul>
        {posts.map((post) => (
          <PostListItem
            post={post}
            timeWidth="w-24"
            descriptionLines={2}
            dateFormat={{ month: "short", day: "numeric", year: "numeric" }}
          />
        ))}
      </ul>

      <p class="meta mt-10 pt-6 border-t border-line">
        <a href="/tags" class="text-accent hover:underline hover:underline-offset-4">
          ← All tags
        </a>
        <span class="opacity-50"> / </span>
        <a href="/posts" class="text-accent hover:underline hover:underline-offset-4">
          All posts
        </a>
      </p>
    </div>
  </div>
</SiteLayout>
