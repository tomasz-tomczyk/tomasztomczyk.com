---
import Icon from "@components/Icon.astro";
import IconLabel from "@components/IconLabel.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import catPortrait from "../assets/tomasz-cat.png";
import catPhoto from "../assets/tomasz-cat-photo.png";
import SiteLayout from "@layouts/SiteLayout.astro";
import { PanelLabel } from "@pressmark/astro";
import PostListItem from "@components/PostListItem.astro";
import { getTags } from "@lib/tags";
import { formatDate, readingTime } from "@lib/utils";
import { SITE, HOME } from "@consts";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* Newest post is the lead; the rest run as a list under it. */
const [lead, ...rest] = posts;
const recent = rest.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const tags = await getTags();
---

<SiteLayout title={SITE.NAME} description={HOME.DESCRIPTION}>
  <div class="px-5 py-10 md:px-12">
    <div class="mx-auto max-w-measure-wide">
      <section class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10 md:items-center mb-14 md:mb-20">
        <div class="md:col-span-7">
          <h1 class="font-display font-light text-4xl md:text-5xl leading-[1.04] text-ink tracking-[-0.015em] mb-8">
            Hi, I'm Tomasz.
          </h1>
          <div class="prose-pressmark space-y-5">
            <p>
              I'm a software engineer who loves leading teams and championing people. Recently I've been at <em><IconLabel label="Vetspire" /></em>,
              where I transitioned from Head of Engineering to Staff Engineer, working with a team spread across the US and UK.
            </p>
            <p>
              I'm passionate about Elixir, DevOps, and the practice of leading teams well. From building car-sharing platforms
              at <em><IconLabel label="Toyota Connected" /></em> to customer-centric work at <em><IconLabel label="Vetspire" /></em>, my focus has always been on delivering
              high-quality solutions and helping my team grow.
            </p>
          </div>
        </div>

        {/* A cut-out, not a photograph: no frame, no rounding — a border would
            box the transparency rather than the subject. He faces the prose.
            The painting crossfades to the photograph it was made from on hover;
            both are laid out in the same box, so they have to share a framing. */}
        <figure class="group relative md:col-span-5 m-0 order-first md:order-none max-w-[18rem] md:max-w-none">
          {/* webp, not the default avif: alpha compresses far better here, and
              the cut-out is nothing but edges against transparency. */}
          <Image
            src={catPortrait}
            alt="Painted illustration of Tomasz holding a ginger cat, both looking off to one side"
            widths={[400, 600, 900]}
            sizes="(min-width: 768px) 26rem, 18rem"
            format="webp"
            quality={68}
            loading="eager"
            class="block w-full h-auto transition-opacity duration-500 ease-out group-hover:opacity-0 motion-reduce:transition-none"
          />
          {/* The painting alone carries the meaning; the photo underneath is
              the same moment, so it takes empty alt rather than repeating it. */}
          <Image
            src={catPhoto}
            alt=""
            widths={[400, 600, 900]}
            sizes="(min-width: 768px) 26rem, 18rem"
            format="webp"
            quality={68}
            loading="lazy"
            aria-hidden="true"
            class="pointer-events-none absolute left-0 top-0 block w-full h-auto opacity-0 transition-opacity duration-500 ease-out group-hover:opacity-100 motion-reduce:transition-none"
          />
        </figure>
      </section>

      {
        lead && (
          <section class="mb-14 md:mb-20 border-t border-raised pt-8 md:pt-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10">
              {/* No artwork column at all when the post has no cover — most
                  don't, and an empty frame is worse than none. */}
              {lead.data.cover && (
                <div class="md:col-span-5 md:order-2">
                  <div class="rounded-md overflow-hidden hairline aspect-[4/3]">
                    <Image
                      src={lead.data.cover}
                      alt={lead.data.coverAlt ?? ""}
                      widths={[420, 840]}
                      sizes="(min-width: 768px) 24rem, 100vw"
                      class="block h-full w-full object-cover"
                      style={`object-position:${lead.data.coverPosition ?? "center"}`}
                    />
                  </div>
                </div>
              )}

              <div
                class:list={[
                  "md:col-span-7",
                  !lead.data.cover && "md:col-span-9",
                ]}
              >
                <p class="meta mb-3 flex flex-wrap items-center gap-x-2.5 gap-y-1">
                  <span class="inline-flex items-center gap-2 whitespace-nowrap">
                    <Icon name="calendar" size={13} class="opacity-70" />
                    {formatDate(lead.data.date)}
                  </span>
                  <span aria-hidden="true" class="opacity-50">·</span>
                  <span class="inline-flex items-center gap-2 whitespace-nowrap">
                    <Icon name="clock" size={13} class="opacity-70" />
                    {readingTime(lead.body ?? "")}
                  </span>
                </p>
                <h2
                  class="font-display font-light text-3xl md:text-4xl lg:text-5xl leading-[1.06] tracking-[-0.014em] max-w-[40rem]"
                >
                  <a
                    href={`/posts/${lead.id}`}
                    class="text-ink hover:text-accent transition-colors"
                  >
                    {lead.data.title}
                  </a>
                </h2>
                <p class="mt-4 text-lg text-ink/75 leading-relaxed max-w-[36rem]">
                  {lead.data.description}
                </p>
                <p class="mt-5">
                  <a href={`/posts/${lead.id}`} class="btn-link">
                    Continue reading <span class="arrow">→</span>
                  </a>
                </p>
              </div>
            </div>
          </section>
        )
      }

      <section class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-12">
        <div class="md:col-span-8">
          <div class="flex items-baseline justify-between mb-5">
            <PanelLabel>More notes</PanelLabel>
            <a href="/posts" class="btn-link">See all <span class="arrow">→</span></a>
          </div>
          <ul class="border-t border-raised">
            {
              recent.map((post) => (
                <PostListItem
                  post={post}
                  timeWidth="w-32"
                  descriptionLines={1}
                />
              ))
            }
          </ul>
        </div>

        <aside class="md:col-span-4 space-y-10 md:pt-1">
          {
            tags.length > 0 && (
              <div>
                <PanelLabel class="mb-3">Tags</PanelLabel>
                <ul class="border-t border-raised">
                  {tags.map((tag) => (
                    <li class="border-b border-raised">
                      <a
                        href={`/tags/${tag.slug}`}
                        class="group flex items-baseline justify-between gap-4 py-2.5 text-ink hover:text-accent transition-colors"
                      >
                        <span class="font-display text-lg"><IconLabel label={tag.name} /></span>
                        <span class="meta shrink-0">{tag.posts.length}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </aside>
      </section>
    </div>
  </div>
</SiteLayout>
