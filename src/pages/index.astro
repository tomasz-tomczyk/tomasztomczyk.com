---
import Icon from "@components/Icon.astro";
import AuthorAnnotation from "@components/AuthorAnnotation.astro";
import IconLabel from "@components/IconLabel.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import catPortrait from "../assets/tomasz-cat.png";
import catPhoto from "../assets/tomasz-cat-photo.png";
import SiteLayout from "@layouts/SiteLayout.astro";
import { PanelLabel } from "@pressmark/astro";
import PostListItem from "@components/PostListItem.astro";
import { getTags } from "@lib/tags";
import { formatDate, readingTime } from "@lib/utils";
import { SITE, HOME, HOME_NOTE } from "@consts";

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/* Newest post is the lead; the rest run as a list under it. */
const [lead, ...rest] = posts;
const recent = rest.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const tags = await getTags();
---

<SiteLayout title={SITE.NAME} description={HOME.DESCRIPTION}>
  <div class="px-5 py-10 md:px-12">
    <div class="mx-auto max-w-measure-wide">
      {/* Three grid children rather than a text column plus a figure: on a
          phone the illustration belongs between the greeting and the prose,
          and only explicit row placement can put the two text blocks back in
          one column from md. */}
      <section class="grid grid-cols-1 md:grid-cols-12 gap-x-8 md:gap-x-10 gap-y-8 mb-14 md:mb-20">
        <h1
          class="md:col-span-7 md:col-start-1 md:row-start-1 md:self-end font-display font-light text-4xl md:text-5xl leading-[1.04] text-ink tracking-[-0.015em]"
        >
          Hi, I'm Tomasz.
        </h1>
        {/* A cut-out, not a photograph: no frame, no rounding — a border would
            box the transparency rather than the subject. He faces the prose.
            The painting crossfades to the photograph it was made from on hover;
            both are laid out in the same box, so they have to share a framing. */}
        <figure class="relative m-0 max-w-[18rem] md:max-w-none mx-auto md:mx-0 md:col-span-5 md:col-start-8 md:row-start-1 md:row-span-2 md:self-center">
          {/* Pinned to the artwork, not the column, so it travels with the
              cut-out. Offsets are percentages because the figure changes width
              at every breakpoint and the cat has to stay under the arrow —
              which hangs off the note's bottom-right, so the note is placed up
              and left of what it points at. Below lg it moves into the empty
              corner above the cat: there is no room beside the figure on a
              phone, and flowing it above the image leaves the arrow pointing
              at the gap rather than the cat. Anchored on its right edge there,
              because the note is a fixed width against a figure that is not —
              pinned on the left, the arrow drifts further across the cat the
              narrower the column gets, and lands on orange fur where it
              cannot be read. */}
          <AuthorAnnotation
            text={HOME_NOTE}
            class="absolute z-10 right-[57%] top-[13%] w-[9rem] lg:right-auto lg:left-0 lg:top-[27%] lg:-translate-x-4"
          />

          {/* A button, not a bare figure: the crossfade was hover-only, so it
              did not exist for touch or for the keyboard. As a toggle it works
              for all three, and without JS the pointer hover still runs. */}
          <button
            type="button"
            class="cat-flip"
            aria-pressed="false"
            aria-label="Show the photograph this painting was made from"
          >
            {/* webp, not the default avif: alpha compresses far better here, and
                the cut-out is nothing but edges against transparency. */}
            <Image
              src={catPortrait}
              alt="Painted illustration of Tomasz holding a ginger cat, both looking off to one side"
              widths={[400, 600, 900]}
              sizes="(min-width: 768px) 26rem, 18rem"
              format="webp"
              quality={68}
              loading="eager"
              class="cat-painting block w-full h-auto transition-opacity duration-500 ease-out motion-reduce:transition-none"
            />
            {/* The painting alone carries the meaning; the photo underneath is
                the same moment, so it takes empty alt rather than repeating it. */}
            <Image
              src={catPhoto}
              alt=""
              widths={[400, 600, 900]}
              sizes="(min-width: 768px) 26rem, 18rem"
              format="webp"
              quality={68}
              loading="lazy"
              aria-hidden="true"
              class="cat-photo pointer-events-none absolute left-0 top-0 block w-full h-auto opacity-0 transition-opacity duration-500 ease-out motion-reduce:transition-none"
            />
          </button>

        </figure>

        <div
          class="prose-pressmark space-y-5 md:col-span-7 md:col-start-1 md:row-start-2 md:self-start"
        >
          <p>
            I'm a software engineer who loves leading teams and championing people. Recently I've been at <em><IconLabel label="Vetspire" /></em>,
            where I transitioned from Head of Engineering to Staff Engineer, working with a team spread across the US and UK.
          </p>
          <p>
            I'm passionate about Elixir, DevOps, and the practice of leading teams well. From building car-sharing platforms
            at <em><IconLabel label="Toyota Connected" /></em> to customer-centric work at <em><IconLabel label="Vetspire" /></em>, my focus has always been on delivering
            high-quality solutions and helping my team grow.
          </p>
        </div>
      </section>

      {
        lead && (
          <section class="mb-14 md:mb-20 border-t border-raised pt-8 md:pt-10">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-10">
              {/* No artwork column at all when the post has no cover — most
                  don't, and an empty frame is worse than none. */}
              {lead.data.cover && (
                <div class="md:col-span-5 md:order-2">
                  <div class="rounded-md overflow-hidden hairline aspect-[4/3]">
                    <Image
                      src={lead.data.cover}
                      alt={lead.data.coverAlt ?? ""}
                      widths={[420, 840]}
                      sizes="(min-width: 768px) 24rem, 100vw"
                      class="block h-full w-full object-cover"
                      style={`object-position:${lead.data.coverPosition ?? "center"}`}
                    />
                  </div>
                </div>
              )}

              <div
                class:list={[
                  "md:col-span-7",
                  !lead.data.cover && "md:col-span-9",
                ]}
              >
                <p class="meta mb-3 flex flex-wrap items-center gap-x-2.5 gap-y-1">
                  <span class="inline-flex items-center gap-2 whitespace-nowrap">
                    <Icon name="calendar" size={14} class="opacity-70" />
                    {formatDate(lead.data.date)}
                  </span>
                  <span aria-hidden="true" class="opacity-50">·</span>
                  <span class="inline-flex items-center gap-2 whitespace-nowrap">
                    <Icon name="clock" size={14} class="opacity-70" />
                    {readingTime(lead.body ?? "")}
                  </span>
                </p>
                <h2
                  class="font-display font-light text-3xl md:text-4xl lg:text-5xl leading-[1.06] tracking-[-0.014em] max-w-[40rem]"
                >
                  <a
                    href={`/posts/${lead.id}`}
                    class="text-ink hover:text-accent transition-colors"
                  >
                    {lead.data.title}
                  </a>
                </h2>
                <p class="mt-4 text-lg text-ink/75 leading-relaxed max-w-[36rem]">
                  {lead.data.description}
                </p>
                <p class="mt-5">
                  <a href={`/posts/${lead.id}`} class="btn-link">
                    Continue reading <span class="arrow">→</span>
                  </a>
                </p>
              </div>
            </div>
          </section>
        )
      }

      {/* Headings on one grid row, lists on the next, so the two columns line
          up structurally: both rules start at the same y and both labels share
          a baseline, whatever the type scale does underneath them. Hand-tuned
          margins cannot hold that — the left heading's height is set by "See
          all", which is a different size from the label beside it. Explicit
          `order` restores the reading sequence on a phone, where the grid
          collapses to one column and the two headings would otherwise pair up
          ahead of their own lists. */}
      <section class="grid grid-cols-1 md:grid-cols-12 gap-x-10 md:gap-x-12 gap-y-5">
        <div class="order-1 md:order-none md:col-span-8 md:col-start-1 md:row-start-1 md:self-baseline flex items-baseline justify-between">
          <PanelLabel>More notes</PanelLabel>
          <a href="/posts" class="btn-link">See all <span class="arrow">→</span></a>
        </div>

        <div class="order-2 md:order-none md:col-span-8 md:col-start-1 md:row-start-2">
          <ul class="border-t border-raised">
            {
              recent.map((post) => (
                <PostListItem
                  post={post}
                  timeWidth="sm:w-32"
                  descriptionLines={1}
                />
              ))
            }
          </ul>
        </div>

        {
          tags.length > 0 && (
            <>
              <div class="order-3 md:order-none mt-6 md:mt-0 md:col-span-4 md:col-start-9 md:row-start-1 md:self-baseline">
                <PanelLabel>Tags</PanelLabel>
              </div>

              <aside class="order-4 md:order-none md:col-span-4 md:col-start-9 md:row-start-2">
                <ul class="border-t border-raised">
                  {tags.map((tag) => (
                    <li class="border-b border-raised">
                      <a
                        href={`/tags/${tag.slug}`}
                        class="group flex items-baseline justify-between gap-4 py-2.5 text-ink hover:text-accent transition-colors"
                      >
                        <span class="font-display text-lg"><IconLabel label={tag.name} /></span>
                        <span class="meta shrink-0">{tag.posts.length}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </aside>
            </>
          )
        }
      </section>
    </div>
  </div>
</SiteLayout>

<style>
  .cat-flip {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* Gated on (hover: hover) so a touch browser's emulated hover cannot fire
     alongside the tap — where both apply, the two fight and the photo latches
     on after the finger lifts. */
  @media (hover: hover) {
    .cat-flip:hover .cat-painting { opacity: 0; }
    .cat-flip:hover .cat-photo { opacity: 1; }
  }

  .cat-flip[aria-pressed="true"] .cat-painting { opacity: 0; }
  .cat-flip[aria-pressed="true"] .cat-photo { opacity: 1; }

  .cat-flip:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: 2px;
  }
</style>

<script>
  /* Progressive enhancement: with no JS the pointer hover still crossfades,
     which is exactly today's behaviour. */
  document.querySelectorAll(".cat-flip").forEach((el) => {
    el.addEventListener("click", () => {
      el.setAttribute(
        "aria-pressed",
        el.getAttribute("aria-pressed") === "true" ? "false" : "true",
      );
    });
  });
</script>
