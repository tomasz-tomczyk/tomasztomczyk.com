---
import SiteLayout from "@layouts/SiteLayout.astro";
import { PanelLabel } from "@pressmark/astro";
import { SITE, SOCIALS, ABOUT, ROLES } from "@consts";
import { SOCIAL_ICONS as ICONS } from "@lib/socialIcons";


const links = [
  {
    ...ICONS.email,
    value: SITE.EMAIL,
    href: `mailto:${SITE.EMAIL}`,
    external: false,
  },
  ...SOCIALS.map((social) => ({
    ...(ICONS[social.NAME] ?? { label: social.NAME, path: "" }),
    value: social.HREF.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, ""),
    href: social.HREF,
    external: true,
  })),
];
---

<SiteLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <div class="px-5 py-10 md:px-12">
    <div class="mx-auto max-w-[46rem]">
      <header class="mb-12">
        <PanelLabel class="mb-7">{ABOUT.TITLE}</PanelLabel>
        <h1 class="font-display font-light text-4xl md:text-5xl leading-[1.04] text-ink tracking-[-0.015em]">
          Hi, I'm Tomasz.
        </h1>
        <div class="prose-pressmark space-y-5 mt-6">
          <p>
            I'm a software engineer who loves leading teams and championing
            people. I care about Elixir, DevOps, and the practice of running
            engineering well — shipping things that hold up, and helping the
            people around me get better at their craft.
          </p>
          <p>
            I live in South London. When I'm not writing code, I'm usually
            writing about it.
          </p>
        </div>
      </header>

      <section class="mb-14">
        <PanelLabel class="mb-5">Work</PanelLabel>
        <ul class="border-t border-raised">
          {ROLES.map((role) => (
            <li class="border-b border-raised py-5">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <p class="font-display text-xl text-ink">
                  {role.TITLE} <span class="text-ink/50">·</span> {role.ORG}
                </p>
                <span class="meta">{role.PERIOD}</span>
              </div>
              <p class="mt-2 text-ink/80 leading-relaxed max-w-[42rem]">
                {role.NOTE}
              </p>
            </li>
          ))}
        </ul>
      </section>

      <PanelLabel class="mb-5">Elsewhere</PanelLabel>

      <ul class="border-t border-raised">
        {links.map((link) => (
          <li class="border-b border-raised">
            <a
              href={link.href}
              class="group flex items-baseline justify-between gap-4 py-4 text-ink hover:text-accent transition-colors"
              {...(link.external
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              <span class="flex items-baseline gap-3 min-w-0">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  class="shrink-0 translate-y-[0.15em] text-ink/70 transition-colors group-hover:text-accent"
                >
                  <path d={link.path} />
                </svg>
                <span class="font-display text-xl">{link.label}</span>
              </span>
              <span class="flex items-center gap-2 min-w-0">
                <span class="meta truncate">{link.value}</span>
                {link.external && (
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    aria-hidden="true"
                    class="shrink-0 opacity-50 transition-opacity group-hover:opacity-90"
                  >
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</SiteLayout>
