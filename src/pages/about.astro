---
import SiteLayout from "@layouts/SiteLayout.astro";
import { DetailList, PanelLabel } from "@pressmark/astro";
import AuthorAnnotation from "@components/AuthorAnnotation.astro";
import {
  SITE,
  SOCIALS,
  ABOUT,
  ABOUT_NOTE,
  ROLES,
  CURRENTLY,
  COLOPHON,
} from "@consts";
import { SOCIAL_ICONS as ICONS } from "@lib/socialIcons";

const links = [
  {
    ...ICONS.email,
    value: SITE.EMAIL,
    href: `mailto:${SITE.EMAIL}`,
    external: false,
  },
  ...SOCIALS.map((social) => ({
    ...(ICONS[social.NAME] ?? { label: social.NAME, path: "" }),
    value: social.HANDLE,
    href: social.HREF,
    external: true,
  })),
];

// Pressmark's DetailList takes lower-case keys; the site config shouts its
// own, so the shape is translated once here rather than at each call site.
const currently = CURRENTLY.ITEMS.map((item) => ({
  label: item.LABEL,
  value: item.VALUE,
}));

const colophon = COLOPHON.map((entry) => ({
  label: entry.LABEL,
  value: entry.VALUE,
}));
---

<SiteLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <div class="px-5 py-10 md:px-12">
    <div class="mx-auto max-w-[64rem]">
      {/* Portrait and name share a baseline: the photo is a column of the
          page, not an avatar dropped into a paragraph. */}
      <section class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-10 md:items-end mb-14 md:mb-20">
        <figure class="col-span-1 md:col-span-4 m-0 max-w-[16rem] md:max-w-none">
          <div class="relative aspect-[4/5] overflow-hidden rounded-md hairline">
            <picture>
              <source srcset="/tomasz-portrait.webp" type="image/webp" />
              <img
                src="/tomasz-portrait.jpg"
                alt="Tomasz Tomczyk outdoors, a pine-covered canyon and river behind him"
                width="800"
                height="1000"
                loading="eager"
                decoding="async"
                class="block h-full w-full object-cover"
              />
            </picture>
          </div>
        </figure>

        <div class="col-span-1 md:col-span-8">
          {/* Fills the dead space the tall portrait leaves above the heading,
              and points back at it. Hidden below md, where the photo is above
              the text and the arrow would point at nothing. */}
          <AuthorAnnotation
            text={ABOUT_NOTE}
            direction="left"
            class="hidden md:block w-[11rem] -ml-5 mb-8"
          />
          <PanelLabel class="mb-4">{ABOUT.TITLE}</PanelLabel>
          <h1
            class="font-display font-light text-4xl md:text-5xl lg:text-6xl leading-[1.02] tracking-[-0.018em] text-ink"
          >
            Hi, I'm Tomasz.
          </h1>
          <p
            class="mt-4 font-display italic text-xl md:text-2xl leading-snug text-muted max-w-[34rem]"
          >
            A software engineer who likes leading teams, shipping things that
            hold up, and writing down what I learned on the way.
          </p>
        </div>
      </section>

      {/* Prose left, standing details right. The aside is the part that goes
          stale — keeping it out of the running text means it can be rewritten
          without touching a sentence. */}
      <section class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12 mb-16 md:mb-24">
        <div class="col-span-1 md:col-span-7 lg:col-span-8">
          <div class="prose-pressmark dropcap">
            {/* The dropcap takes the first letter of this paragraph, so it
                has to open on a plain capital — "I'm" gives you a giant I and
                an orphaned apostrophe. */}
            <p>
              My job title says software engineer, but the part I care about
              most is leading teams and championing people. Elixir, DevOps, and
              the practice of running engineering well — shipping things that
              hold up, and helping the people around me get better at their
              craft.
            </p>
            <p>
              Most of what I know I learned the slow way: from production
              incidents, from code review, from being wrong in front of people
              who were generous about it. This site is where I write that down,
              partly so someone else skips a step, mostly so I can find it again
              myself.
            </p>
            <p>
              I live in South London. When I'm not writing code, I'm usually
              writing about it.
            </p>
          </div>
        </div>

        <aside class="col-span-1 md:col-span-5 lg:col-span-4 space-y-10 md:pt-2">
          <div>
            <PanelLabel class="mb-3">Currently</PanelLabel>
            <DetailList items={currently} labelWidth="4rem" />
            <p class="mt-3 meta">True as of {CURRENTLY.UPDATED}.</p>
          </div>

          <div>
            <PanelLabel class="mb-3">Elsewhere</PanelLabel>
            <ul class="border-t border-raised">
              {/* The network name is a label, not a destination — only the
                  handle links out, so the row reads as "GitHub: this is me". */}
              {links.map((link) => (
                <li class="flex items-baseline justify-between gap-4 border-b border-raised py-3">
                  <span class="flex items-baseline gap-2.5 shrink-0">
                    <svg
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                      class="shrink-0 translate-y-[0.15em] text-ink/70"
                    >
                      <path d={link.path} />
                    </svg>
                    <span class="font-display text-lg text-ink">
                      {link.label}
                    </span>
                  </span>
                  <a
                    href={link.href}
                    class="meta truncate min-w-0 text-ink/80 underline decoration-ink/25 decoration-1 underline-offset-[0.25em] hover:text-accent hover:decoration-accent transition-colors"
                    {...(link.external
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {link.value}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </section>

      <section class="mb-16 md:mb-24">
        <PanelLabel class="mb-5">Work</PanelLabel>
        <ul class="border-t border-raised">
          {ROLES.map((role) => (
            <li class="grid grid-cols-1 md:grid-cols-12 gap-x-10 gap-y-2 border-b border-raised py-6">
              <div class="md:col-span-3">
                <span class="meta">{role.PERIOD}</span>
              </div>
              <div class="md:col-span-9">
                <p class="font-display text-xl md:text-2xl text-ink leading-snug">
                  {role.TITLE} <span class="text-ink/40">·</span> {role.ORG}
                </p>
                <p class="mt-2 text-ink/80 leading-relaxed max-w-[42rem]">
                  {role.NOTE}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      {/* The site explaining itself. Small print by design — anyone who wants
          it will look here, and nobody else has to read past it. */}
      <section class="border-t border-raised pt-10">
        <PanelLabel class="mb-6">Colophon</PanelLabel>
        <DetailList
          items={colophon}
          layout="stacked"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-6"
        />
      </section>
    </div>
  </div>
</SiteLayout>
