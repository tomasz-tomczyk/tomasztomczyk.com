---
import Icon from "@components/Icon.astro";
import IconLabel from "@components/IconLabel.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { DetailList, PanelLabel } from "@pressmark/astro";
import AuthorAnnotation from "@components/AuthorAnnotation.astro";
import IllustratedPanel from "@components/IllustratedPanel.astro";
import cvDesk from "../assets/cv-desk.png";
import {
  SITE,
  SOCIALS,
  ABOUT,
  ABOUT_NOTE,
  CURRENTLY,
  COLOPHON,
  PROJECTS,
} from "@consts";
import { SOCIAL_ICONS as ICONS } from "@lib/socialIcons";

const links = [
  {
    ...ICONS.email,
    value: SITE.EMAIL,
    href: `mailto:${SITE.EMAIL}`,
    external: false,
  },
  ...SOCIALS.map((social) => ({
    ...(ICONS[social.NAME] ?? { label: social.NAME, icon: undefined }),
    value: social.HANDLE,
    href: social.HREF,
    external: true,
  })),
];

// Pressmark's DetailList takes lower-case keys; the site config shouts its
// own, so the shape is translated once here rather than at each call site.
const currently = CURRENTLY.ITEMS.map((item) => ({
  label: item.LABEL,
  value: item.VALUE,
}));

const colophon = COLOPHON.map((entry) => ({
  label: entry.LABEL,
  value: entry.VALUE,
}));
---

<SiteLayout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <div class="px-5 py-10 md:px-12">
    <div class="mx-auto max-w-measure-wide">
      {/* items-end: portrait and name share a baseline. */}
      <section class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-10 md:items-end mb-14 md:mb-20">
        <figure
          class="polaroid col-span-1 md:col-span-4 m-0 max-w-[16rem] md:max-w-none mx-auto md:mx-0"
        >
          <div class="relative aspect-[4/5] overflow-hidden">
            <picture>
              <source srcset="/tomasz-portrait.webp" type="image/webp" />
              <img
                src="/tomasz-portrait.jpg"
                alt="Tomasz Tomczyk outdoors, a pine-covered canyon and river behind him"
                width="800"
                height="1000"
                loading="eager"
                decoding="async"
                class="block h-full w-full object-cover"
              />
            </picture>
          </div>
        </figure>

        <div class="col-span-1 md:col-span-8">
          {/* Hidden below md: the photo stacks above the text there, so the
              arrow would point at nothing. */}
          <AuthorAnnotation
            text={ABOUT_NOTE}
            direction="left"
            class="hidden md:block w-[11rem] -ml-5 mb-8"
          />
          <h1
            class="font-display font-light text-4xl md:text-5xl lg:text-6xl leading-[1.02] tracking-[-0.018em] text-ink"
          >
            Hi, I'm Tomasz.
          </h1>
          <p class="dek-voice mt-4 max-w-[34rem]">
            A staff engineer who likes solving puzzles, championing people, sharing best practices and learnings in attempts to build better products and teams.
          </p>
        </div>
      </section>

      {/* Prose left, standing details right. The aside holds everything that
          goes stale, so it can be rewritten without touching a sentence. */}
      <section class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12 mb-16 md:mb-24">
        <div class="col-span-1 md:col-span-7 lg:col-span-8">
          <div class="prose-pressmark dropcap">
            <p>
              Born in Poland, programming from an early age I've been pursuing programming and English. I ended up combining these when I moved abroad to study in the UK. I am now settled there, with a beautiful wife and daughter (and cat).
            </p>
            <p>
              In the last decade or so I've been working on supporting teams and individuals; improving processes, communication and culture around shipping software in the roles of Tech Lead and Head of Engineering; now I've sidestepped into more IC-focused role as a staff engineer and I spend more time on developer tooling, solving hard technical problems and unblocking critical issues for the business.
            </p>
            <p>
              I live in South London. In my spare time, I build Crit (see below), hang out with my family and game!
            </p>
          </div>
        </div>

        <aside class="col-span-1 md:col-span-5 lg:col-span-4 space-y-10 md:pt-2">
          <div>
            <PanelLabel class="mb-3">Currently</PanelLabel>
            <dl class="flex flex-col gap-2.5">
              {currently.map((item) => (
                <div class="flex items-baseline gap-3">
                  <dt class="panel-label shrink-0 w-16">{item.label}</dt>
                  <dd class="text-ink leading-snug m-0">
                    {item.value.split(/(Vetspire)/).map((part) => (
                      <IconLabel label={part} />
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
          </div>

          <div>
            <PanelLabel class="mb-3">Elsewhere</PanelLabel>
            <ul class="border-t border-raised">
              {/* The network name is a label, not a destination — only the
                  handle links out. */}
              {links.map((link) => (
                <li class="flex items-baseline justify-between gap-4 border-b border-raised py-3">
                  <span class="flex items-baseline gap-2.5 shrink-0">
                    {link.icon && <Icon name={link.icon} size={16} class="text-ink/70" />}
                    <span class="font-display text-lg text-ink">
                      {link.label}
                    </span>
                  </span>
                  <span class="meta truncate min-w-0">
                    <a
                      href={link.href}
                      class="link"
                      {...(link.external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      {link.value}
                    </a>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </section>

      {/* One line each — the detail belongs on the project's own site. */}
      <section class="mb-16 md:mb-24">
        <PanelLabel class="mb-6">Projects</PanelLabel>
        <ul class="border-t border-raised">
          {PROJECTS.map((project) => (
            <li
              class="grid grid-cols-1 gap-1 border-b border-raised py-3 sm:grid-cols-12 sm:gap-6 sm:items-baseline"
            >
              <span class="sm:col-span-3 font-display text-lg text-ink">
                <a
                  href={project.HREF}
                  class="link"
                  {...(project.HREF.startsWith("http")
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {project.NAME}
                </a>
              </span>
              {/* Ink, not `meta`: at 68% ink the note reads as a caption under
                  a heading rather than as the line that carries the sense. */}
              <span class="sm:col-span-9 text-ink leading-snug">{project.NOTE}</span>
            </li>
          ))}
        </ul>
      </section>

      {/* The whole history lives on /cv; this is a signpost, not a summary.
          One line of copy, so the drawing is narrow and the link sits on the
          same line as the question rather than under it. */}
      <IllustratedPanel
        src={cvDesk}
        alt=""
        side="right"
        artWidth="8rem"
        seed={19}
        class="mb-16 md:mb-24"
      >
        <h2>
          Looking for my CV? <a href="/cv" class="link">Read it &rarr;</a>
        </h2>
      </IllustratedPanel>

      {/* No rule above this one: it follows the torn sheet, and a hairline
          under a deckled edge reads as a border on the sheet. */}
      <section class="pt-10">
        <PanelLabel class="mb-6">Colophon</PanelLabel>
        <DetailList
          items={colophon}
          layout="stacked"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-10 gap-y-6"
        />
      </section>
    </div>
  </div>
</SiteLayout>

<style>
  /* The portrait as a print: an even border on three sides and a deeper lip
     below. Those proportions are what makes it read as a polaroid, so they are
     fixed lengths — scaling the lip with the image loses it. Square corners for
     the same reason. The tilt is on the figure so the shadow tilts with it, and
     stays under 2deg: the section aligns the photo and the h1 on a baseline,
     and a steeper angle visibly breaks that line. */
  .polaroid {
    background: var(--color-raised);
    padding: 0.8rem 0.8rem 3rem;
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--color-ink) 18%, transparent),
      0 14px 28px -16px color-mix(in srgb, var(--color-ink) 45%, transparent);
    transform: rotate(-1.4deg);
    transform-origin: 60% 60%;
  }

  /* Slotted into IllustratedPanel, so these sit in this page's scope. */
  h2 {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }
</style>
