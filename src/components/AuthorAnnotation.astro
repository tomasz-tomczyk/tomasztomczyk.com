---
/**
 * The handwritten aside beside the byline.
 *
 * Deliberately outside Pressmark: the theme ships one look and two faces, and
 * a note in the author's own voice is content about *me*, not a theme
 * primitive. The face (`--font-hand`) and the accent ink both live here.
 *
 * It appears on every post, so it carries information rather than a joke — a
 * joke is stale by the third read. The arrow hangs off the end of the line and
 * drops into the avatar, so the note reads as pinned to the face beside it.
 */
type Props = {
  text: string;
  /**
   * Which way the arrow points. Default `"right"` is the post byline, where
   * the note sits left of the avatar. `"left"` mirrors the whole thing for
   * the /about hero, where the photo is on the other side.
   */
  direction?: "left" | "right";
  class?: string;
};

const {
  text,
  direction = "right",
  class: className = "",
} = Astro.props as Props;

const flipped = direction === "left";
---

<div
  class:list={[
    "author-annotation select-none",
    flipped && "flipped",
    className,
  ]}
>
  <p class="hand text-accent">{text}</p>

  <svg
    class:list={[
      "text-accent block",
      /* The byline tucks the arrow up under the end of a right-aligned line.
         Flipped, the tail rises on the same side the text starts on, so the
         tuck would cross the last line — it gets clearance instead. */
      flipped ? "mr-auto -scale-x-100 mt-3" : "ml-auto -mt-2",
    ]}
    width="74"
    height="42"
    viewBox="0 0 74 42"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M10 2C10 22 24 30 66 33" />
    <path d="M57.3 27.1 66 33 56.6 37.6" />
  </svg>
</div>

<style>
  .hand {
    font-family: var(--font-hand);
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.15;
    /* Small enough to read as a note pinned to the page rather than as a
       layout bug. Past ~8deg it stops looking deliberate. */
    transform: rotate(-7deg);
    transform-origin: left center;
    /* The text may carry hyphens; without this the wrap lands after one of
       them and splits a syllable across lines. */
    hyphens: none;
  }

  /* Mirroring the arrow alone leaves the text tilting away from what it
     points at, so the tilt flips with it. Both lines start on the arrow's own
     left edge, so the note stacks over the arrow rather than drifting off to
     the right of it. */
  .flipped .hand {
    transform: rotate(7deg);
    text-align: left;
  }
</style>
