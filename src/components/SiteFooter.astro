---
import Icon from "@components/Icon.astro";
import { Image } from "astro:assets";
import { SITE, REPO } from "@consts";
import { SOCIAL_ICONS as ICONS } from "@lib/socialIcons";
import catCurled from "../assets/cat-curled.png";
import catLounging from "../assets/cat-lounging.png";
import catSitting from "../assets/cat-sitting.png";
import catSlouching from "../assets/cat-slouching.png";

// Every source is trimmed to the cat and scaled to a common 400px height, so
// the sizing below can be by height and each pose reads at the same scale
// however wide it happens to be.
const cats = [
  { src: catCurled, alt: "My cat Dr Harvey Cinnamon, curled up asleep" },
  { src: catLounging, alt: "My cat Dr Harvey Cinnamon, lounging" },
  { src: catSitting, alt: "My cat Dr Harvey Cinnamon, sitting to attention" },
  { src: catSlouching, alt: "My cat Dr Harvey Cinnamon, slouching and unimpressed" },
];

const cat = cats[Math.floor(Math.random() * cats.length)];

const year = new Date().getFullYear();

// One link, and it is the source of the page you are reading — not my profile,
// and not the other networks. Those are the /about "Elsewhere" list's job.
const source = { ...ICONS.github, label: "Source on GitHub", href: REPO };
---

{/* The cat sits on the rule rather than above it: the top border is drawn on
    this element, and the figure is pulled up by half its own height so the
    hairline passes behind the body and reads as a shelf. Negative margin on
    the figure, not a transform, so the footer's own box still reserves the
    space the overhang needs. The offsets are half of h-24 / h-32 and must
    follow if those change. The pose is picked at build time, so a page keeps
    one cat and no layout shifts on load. */}
<footer class="mt-14 md:mt-20 border-t border-raised">
  <div class="px-5 md:px-12">
    <div class="mx-auto max-w-measure-wide">
      <figure class="m-0 -mt-12 md:-mt-16 mb-6 md:mb-8 flex justify-end">
        <Image
          src={cat.src}
          alt={cat.alt}
          height={256}
          format="webp"
          quality={72}
          loading="lazy"
          class="block h-24 md:h-32 w-auto"
        />
      </figure>

      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between pb-10 md:pb-14"
      >
        <p class="meta">© {year} {SITE.NAME}</p>

        <a
          href={source.href}
          target="_blank"
          rel="noopener noreferrer"
          class="block text-ink/60 hover:text-accent transition-colors"
        >
          <span class="sr-only">{source.label}</span>
          {source.icon && <Icon name={source.icon} size={19} class="block" />}
        </a>
      </div>
    </div>
  </div>
</footer>
