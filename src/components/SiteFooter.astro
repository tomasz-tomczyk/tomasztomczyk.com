---
import { Image } from "astro:assets";
import { SITE, SOCIALS } from "@consts";
import { SOCIAL_ICONS as ICONS } from "@lib/socialIcons";
import catLounging from "../assets/cat-lounging.png";

const year = new Date().getFullYear();

const links = SOCIALS.map((social) => ({
  ...(ICONS[social.NAME] ?? { label: social.NAME, path: "" }),
  href: social.HREF,
}));
---

{/* The cat sits on the rule rather than above it: the top border is drawn on
    this element, and the figure is pulled up by half its own height so the
    hairline passes behind the body and reads as a shelf. Negative margin on
    the figure, not a transform, so the footer's own box still reserves the
    space the overhang needs. */}
<footer class="mt-20 md:mt-28 border-t border-raised">
  <div class="px-5 md:px-12">
    <div class="mx-auto max-w-measure-wide">
      <figure class="m-0 -mt-[3.25rem] md:-mt-[4.25rem] mb-6 md:mb-8 flex justify-end">
        <Image
          src={catLounging}
          alt="My cat Dr Harvey Cinnamon"
          widths={[200, 400]}
          sizes="(min-width: 768px) 15rem, 11rem"
          format="webp"
          quality={72}
          loading="lazy"
          class="block w-44 md:w-60 h-auto"
        />
      </figure>

      <div
        class="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between pb-10 md:pb-14"
      >
        <p class="meta">
          © {year} {SITE.NAME} <span class="mx-1 opacity-50">·</span> Built with
          Astro
        </p>

        <ul class="flex items-center gap-5">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block text-ink/60 hover:text-accent transition-colors"
                >
                  <span class="sr-only">{link.label}</span>
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={link.path} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>
