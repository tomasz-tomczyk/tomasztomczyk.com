---
import { Topbar, type TopbarItem } from "@pressmark/astro";

type Props = {
  currentPath?: string;
};

const { currentPath = "/" } = Astro.props;

// Topbar rather than Pressmark's Sidebar: the rail earns its 260px on sites
// with many sections, and this one has three.
const items: TopbarItem[] = [
  { href: "/", label: "Home" },
  { href: "/posts", label: "Posts" },
  { href: "/about", label: "About" },
];
---

<Topbar brand="/TT" items={items} currentPath={currentPath} />
