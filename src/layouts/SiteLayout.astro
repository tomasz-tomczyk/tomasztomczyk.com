---
import { BaseLayout } from "@pressmark/astro";
import TomaszNav from "@components/TomaszNav.astro";
import SiteFooter from "@components/SiteFooter.astro";
import { SITE } from "@consts";
import { resolveTheme, type PostTheme } from "@lib/postTheme";
import "@styles/global.css";

type Props = {
  title: string;
  description: string;
  /** Emit og:type=article instead of the default website (used by posts). */
  article?: boolean;
  /** Absolute URL to a cover image; when set, emits og:image and upgrades twitter:card. */
  image?: string;
  /**
   * Per-post look. Re-points Pressmark's colour and font roles on <html>, so
   * the nav and footer theme along with the article rather than staying cream
   * around a dark page.
   */
  theme?: PostTheme;
  /** Identifies the post in the build error when a theme is unreadable. */
  themeSource?: string;
};

const {
  title,
  description,
  article = false,
  image,
  theme,
  themeSource,
} = Astro.props;

const currentPath = Astro.url.pathname;
const fullTitle = title === SITE.NAME ? title : `${title} | ${SITE.NAME}`;
const canonicalURL = new URL(currentPath, Astro.site).href;

// Throws at build time if the post re-points the surface but leaves a text
// role behind.
const resolved = resolveTheme(theme, themeSource ?? currentPath);

const htmlAttrs: Record<string, string | undefined> = {
  style: resolved.style,
  "data-scheme": resolved.colorScheme,
};
---

{/* `fonts={false}`: every face is self-hosted, declared in src/styles/fonts.css.
    `favicon={false}`: the real icon set is in the head slot below. Both stop
    BaseLayout emitting its own, which would otherwise compete rather than be
    replaced. */}
<BaseLayout
  title={fullTitle}
  description={description}
  htmlAttrs={htmlAttrs}
  favicon={false}
  fonts={false}
>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalURL} />

    {/* The TT monogram. These must stay in this slot rather than move into
        Pressmark: BaseLayout hardcodes its own placeholder <link rel="icon">
        and takes no prop to replace it, so all a consumer can do is declare a
        better-specified icon afterwards and let the browser prefer it. Hence
        the explicit `type` and `sizes` on every entry — an icon link with no
        metadata is exactly what the placeholder is, and the tie is what we are
        trying to win. */}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    {/* iOS ignores `sizes` here and rescales whatever it finds; one 180px
        opaque image is the whole contract. Transparency would come out black
        on the home screen, so the file is flattened onto the page cream. */}
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F6F4EE" />

    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.NAME} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {/* Scrollbars and form controls match the page rather than flashing light
        chrome on a dark post. Derived from the surface colour, not from the
        reader's preference. */}
    <meta name="color-scheme" content={resolved.colorScheme} />

    {/* Faces this post asked for, loaded only on this page. */}
    {resolved.fontUrl && <link rel="stylesheet" href={resolved.fontUrl} />}

    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="2c50a436-e556-47ee-b685-8bc5727fb84d"
    ></script>
  </Fragment>

  <TomaszNav currentPath={currentPath} />

  {/* pt-14 clears the fixed Topbar. */}
  <main class="pt-14">
    <slot />
  </main>

  <SiteFooter />
</BaseLayout>
