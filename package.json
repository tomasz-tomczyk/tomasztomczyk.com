{
  "name": "astro-nano",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview --host --port 4322",
    "test": "node --experimental-strip-types --no-warnings src/lib/postTheme.test.ts && node --experimental-strip-types --no-warnings src/lib/utils.test.ts && node --experimental-strip-types --no-warnings src/lib/comments.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pressmark:local": "node scripts/pressmark-link.mjs local",
    "pressmark:npm": "node scripts/pressmark-link.mjs npm",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@pressmark/astro": "^0.9.0",
    "@pressmark/theme": "^0.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "typescript": "^6.0.3"
  }
}
